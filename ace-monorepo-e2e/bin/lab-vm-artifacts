#!/usr/bin/env python3
"""Fetch the public, pinned inputs for the disposable ARM64 lab fixture."""
import concurrent.futures
import base64
import binascii
import hashlib
import json
import os
from pathlib import Path
import re
import tempfile
import subprocess
import urllib.parse
import urllib.request

ROOT = Path(__file__).resolve().parents[2]
FIXTURE = ROOT / "ace-monorepo-e2e" / "lab-vm"
CACHE = ROOT / ".ace-local" / "lab-vm" / "artifacts"


class HttpsRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if urllib.parse.urlsplit(newurl).scheme != "https":
            raise ValueError("download redirected to a non-HTTPS URL")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def inventory():
    manifest = json.loads((FIXTURE / "release-manifest.json").read_text())
    if manifest.get("schema") != "ace-e2e-release/v1":
        raise ValueError("unknown release manifest schema")
    entries = []
    for item in manifest["gems"]:
        name, version = item["name"], item["version"]
        if not re.fullmatch(r"[a-zA-Z0-9_-]+", name) or not re.fullmatch(r"[a-zA-Z0-9.]+", version):
            raise ValueError("invalid gem name or version")
        filename = f"{name}-{version}.gem"
        if item["source"] == "https://rubygems.org":
            url = f"https://rubygems.org/downloads/{filename}"
        elif item["source"] == "local":
            commit = item.get("source_commit", "")
            if name not in ("ace-task", "ace-runtime", "ace-coworker", "ace-wake", "ace-lab", "ace-herdr", "ace-git-forgejo", "ace-overseer", "ace-handbook-integration-pi") or not re.fullmatch(r"[a-f0-9]{40}", commit):
                raise ValueError("invalid local gem build source")
            url = f"local:{name}:{version}:{commit}"
        else:
            raise ValueError("unexpected gem source")
        entries.append((filename, url, item["sha256"]))
    for key in ("ruby_source", "node", "zig", "rustup"):
        item = manifest[key]
        parsed = urllib.parse.urlsplit(item["url"])
        if parsed.scheme != "https" or not parsed.netloc or parsed.query or parsed.fragment:
            raise ValueError(f"invalid {key} URL")
        entries.append((Path(parsed.path).name, item["url"], item["sha256"]))
    channel = manifest["rustup"]
    channel_url = urllib.parse.urlsplit(channel["channel_manifest_url"])
    if channel_url.scheme != "https" or channel_url.netloc != "static.rust-lang.org" or channel_url.query or channel_url.fragment:
        raise ValueError("invalid Rust channel manifest URL")
    entries.append((Path(channel_url.path).name, channel["channel_manifest_url"], channel["channel_manifest_sha256"]))
    names = set()
    for name, _, digest in entries:
        if name in names or not re.fullmatch(r"[a-f0-9]{64}", digest):
            raise ValueError(f"duplicate artifact or invalid digest: {name}")
        names.add(name)
    lock = json.loads((FIXTURE / manifest["pi"]["lockfile"]).read_text())
    package = lock["packages"][""]["dependencies"]
    if package.get(manifest["pi"]["package"]) != manifest["pi"]["version"]:
        raise ValueError("Pi lockfile does not match release manifest")
    for name, item in lock["packages"].items():
        if name and item.get("resolved"):
            integrity = item.get("integrity", "")
            try:
                valid_digest = integrity.startswith("sha512-") and len(base64.b64decode(integrity[7:], validate=True)) == 64
            except (binascii.Error, ValueError):
                valid_digest = False
            if not item["resolved"].startswith("https://registry.npmjs.org/") or not valid_digest:
                raise ValueError(f"unpinned npm artifact: {name}")
    return entries


def verified(path, expected):
    if path.is_symlink():
        raise ValueError(f"artifact is a symlink: {path}")
    if not path.is_file():
        return False
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest() == expected


def fetch(entry):
    name, url, expected = entry
    destination = CACHE / name
    if verified(destination, expected):
        return name, "cached"
    if url.startswith("local:"):
        _, package, version, commit = url.split(":")
        builder = ROOT / "ace-monorepo-e2e" / "bin" / "lab-vm-build-gem"
        subprocess.run([str(builder), package, commit, version], check=True, stdout=subprocess.DEVNULL)
        if not verified(destination, expected):
            raise ValueError(f"local build SHA-256 mismatch for {name}")
        return name, "built"
    fd, temporary = tempfile.mkstemp(prefix=".download-", dir=CACHE)
    try:
        digest = hashlib.sha256()
        opener = urllib.request.build_opener(HttpsRedirect())
        with os.fdopen(fd, "wb") as target, opener.open(url, timeout=90) as response:
            if urllib.parse.urlsplit(response.geturl()).scheme != "https":
                raise ValueError("download redirected to a non-HTTPS URL")
            for block in iter(lambda: response.read(1024 * 1024), b""):
                target.write(block)
                digest.update(block)
            target.flush()
            os.fsync(target.fileno())
        if digest.hexdigest() != expected:
            raise ValueError(f"SHA-256 mismatch for {name}")
        os.replace(temporary, destination)
        return name, "downloaded"
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main():
    entries = inventory()
    current = ROOT
    for part in (".ace-local", "lab-vm", "artifacts"):
        current = current / part
        if current.is_symlink():
            raise ValueError(f"artifact cache path is a symlink: {current}")
        current.mkdir(exist_ok=True, mode=0o700)
        info = current.stat()
        if not current.is_dir() or info.st_uid != os.getuid() or (part != ".ace-local" and info.st_mode & 0o077):
            raise ValueError(f"artifact cache path is not private and owned: {current}")
    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as executor:
        results = list(executor.map(fetch, entries))
    print(json.dumps({"artifacts": len(results), "downloaded": sum(s == "downloaded" for _, s in results),
                      "built": sum(s == "built" for _, s in results),
                      "cached": sum(s == "cached" for _, s in results), "cache": str(CACHE)}, indent=2))


if __name__ == "__main__":
    main()
