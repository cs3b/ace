#!/usr/bin/env ruby
# frozen_string_literal: true

# Create a new private, isolated GitHub repository and issue set for one run.
# This command never accepts or resets an existing repository.
require "json"
require "yaml"
require "open3"
require "fileutils"
require "securerandom"
require "tempfile"
load File.expand_path("lab-vm", __dir__)

def execute(*argv, chdir: nil)
  options = chdir ? {chdir: chdir} : {}
  out, err, status = Open3.capture3(*argv, **options)
  raise "#{argv.first} failed: #{err.lines.first.to_s.strip}" unless status.success?
  out.strip
end

def save_receipt(path, receipt)
  Tempfile.create(["fixture-", ".json"], File.dirname(path)) do |file|
    file.chmod(0o600)
    file.write(JSON.pretty_generate(receipt) + "\n")
    file.flush
    file.fsync
    File.rename(file.path, path)
  end
end

receipt_path = nil
begin
  raise "usage: lab-vm-github-fixture create" unless ARGV == ["create"]
  LabVm.with_lifecycle_lock do
    owner = execute("gh", "api", "user", "--jq", ".login")
    raise "invalid GitHub login" unless owner.match?(/\A[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})\z/)
    run_id = SecureRandom.hex(8)
    repository = "#{owner}/ace-utm-e2e-#{run_id}"
    parent = File.join(LabVm.local_dir, "runs")
    raise "run directory is a symlink" if File.symlink?(parent)
    Dir.mkdir(parent, 0o700) unless File.exist?(parent)
    raise "run directory is not private" unless File.directory?(parent) && File.stat(parent).uid == Process.uid && (File.stat(parent).mode & 0o077).zero?
    dir = File.join(parent, run_id)
    Dir.mkdir(dir, 0o700)
    receipt_path = File.join(dir, "fixture.json")
    source_sha = execute("git", "rev-parse", "HEAD", chdir: LabVm::ROOT)
    raise "invalid source commit" unless source_sha.match?(/\A[0-9a-f]{40}\z/)
    receipt = {"schema" => "ace-e2e-github-fixture/v1", "run_id" => run_id, "repository" => repository,
      "source_sha" => source_sha, "status" => "preparing", "issues" => {}}
    save_receipt(receipt_path, receipt)

    checkout = File.join(dir, "repository")
    Dir.mkdir(checkout, 0o700)
    archive = File.join(dir, "source.tar")
    execute("git", "archive", "--format=tar", "--output=#{archive}", source_sha, chdir: LabVm::ROOT)
    execute("tar", "-xf", archive, "-C", checkout)
    File.unlink(archive)
    execute("git", "init", "-q", "-b", "main", checkout)
    execute("git", "config", "user.name", "ACE E2E Fixture", chdir: checkout)
    execute("git", "config", "user.email", "ace-e2e@example.invalid", chdir: checkout)
    execute("git", "-c", "core.hooksPath=/dev/null", "add", "-A", chdir: checkout)
    execute("git", "-c", "core.hooksPath=/dev/null", "commit", "-q", "-m", "Seed ACE E2E fixture from #{source_sha}", chdir: checkout)
    initial_sha = execute("git", "rev-parse", "HEAD", chdir: checkout)
    receipt["initial_sha"] = initial_sha
    receipt["status"] = "creating_repository"
    save_receipt(receipt_path, receipt)
    execute("gh", "repo", "create", repository, "--private", "--description", "Disposable ACE UTM E2E fixture #{run_id}")
    receipt["status"] = "repository_created"
    save_receipt(receipt_path, receipt)
    # The copied source contains production workflow definitions. Tests for
    # this fixture execute inside the guest, so do not start hosted workflows.
    execute("gh", "api", "--method", "PUT", "repos/#{repository}/actions/permissions", "--field", "enabled=false")
    execute("git", "remote", "add", "origin", "https://github.com/#{repository}.git", chdir: checkout)
    execute("git", "-c", "credential.helper=", "-c", "credential.helper=!gh auth git-credential", "push", "-q", "-u", "origin", "main", chdir: checkout)
    receipt["status"] = "creating_issues"
    save_receipt(receipt_path, receipt)

    fixture = YAML.safe_load_file(File.join(LabVm::ROOT, "ace-monorepo-e2e/lab-vm/fixtures/github-issues.yml"), permitted_classes: [], aliases: false)
    fixture.fetch("issues").each do |issue|
      key = issue.fetch("key")
      raise "invalid or duplicate issue key" unless key.match?(/\A[a-z][a-z0-9_-]*\z/) && !receipt["issues"].key?(key)
      body = issue.fetch("body").gsub(/\{\{issue:([a-z][a-z0-9_-]*)\}\}/) do
        receipt.fetch("issues").fetch(Regexp.last_match(1)).fetch("url")
      end
      url = execute("gh", "issue", "create", "--repo", repository, "--title", issue.fetch("title"), "--body", body)
      raise "unexpected issue URL" unless url.match?(%r{\Ahttps://github\.com/#{Regexp.escape(repository)}/issues/\d+\z})
      receipt["issues"][key] = {"url" => url, "depends_on" => issue.fetch("depends_on", []), "kind" => issue["kind"]}
      save_receipt(receipt_path, receipt)
    end
    receipt["status"] = "ready"
    save_receipt(receipt_path, receipt)
    puts JSON.pretty_generate(receipt.merge("receipt" => receipt_path))
  end
rescue StandardError => e
  warn "lab-vm-github-fixture: #{e.message}"
  warn "Fixture receipt: #{receipt_path}" if receipt_path
  warn "Any partially created fixture is retained for inspection; no existing repository is reused or removed."
  exit 1
end
