#!/usr/bin/env ruby
# frozen_string_literal: true

# Publishes pending ace-* gems to RubyGems.org in dependency order.
#
# Built after a failed live burst (2026-09) where GEM_HOST_API_KEY resolved empty
# from mise.toml's {{env.GEM_HOST_API_KEY}} indirection and the collected OTP was
# burned on rejected pushes. This script validates credentials BEFORE any OTP is
# consumed, precomputes the dependency-ordered queue, builds every artifact, and
# only then starts the ≤5-concurrent push burst. Failed runs are resumable:
# rerun with a fresh OTP and already-published versions are skipped.

require "open3"
require "pathname"
require "rubygems"
require "rubygems/package"

ROOT = Pathname.new(__FILE__).dirname.parent.realpath
MAX_CONCURRENCY = 5
PROBE_GEM = "ace-support-core"
NON_OTP_ENV = {"GEM_HOST_OTP_CODE" => nil}.freeze
NON_SECRET_ENV = {"GEM_HOST_API_KEY" => nil, "GEM_HOST_OTP_CODE" => nil}.freeze
OTP_PATTERN = /\A[[:alnum:]]{6,8}\z/

def usage
  <<~USAGE
    NAME
      ace-rubygems-publish - publish pending ace-* gems to RubyGems.org in dependency order

    SYNOPSIS
      .ace-bin/ace-rubygems-publish [OPTIONS] [gem-name...]
      .ace-bin/ace-rubygems-publish --prepare [gem-name...]
      .ace-bin/ace-rubygems-publish --dry-run [gem-name...]

    ARGUMENTS
      [gem-name...]  Restrict the queue to these gems. Their pending ace-* runtime
                     dependencies are included automatically so the dependency
                     order stays publishable.

    OPTIONS
      --dry-run      Print the publish queue (order, waves, versions, artifacts)
                     without building, pushing, or consuming an OTP.
      --prepare      Validate credentials and build the full pending queue, but do
                     not require an OTP or push. Run this before requesting an OTP.
      --help, -h     Show this help.

    CREDENTIALS
      GEM_HOST_API_KEY must be set and non-empty in this shell (it is validated
      against RubyGems before anything is pushed), or ~/.gem/credentials must exist.
      GEM_HOST_OTP_CODE must contain a 6-8 character one-time password in live mode.
      Both variables are inherited by RubyGems and are never copied into command
      arguments or output. Note: a mise.toml entry like
      GEM_HOST_API_KEY = { value = "{{env.GEM_HOST_API_KEY}}" }
      resolves EMPTY unless the calling shell already exports the key.

    SAFETY
      - All builds finish before the first push; any build failure aborts before
        the OTP is consumed.
      - Pushes run in dependency-respecting waves of up to 5 concurrent pushes.
      - First push failure stops the burst; unpublished artifacts are kept on
        disk. Rerun with a fresh OTP to resume (published versions are skipped).

    EXAMPLES
      .ace-bin/ace-rubygems-publish --dry-run
      .ace-bin/ace-rubygems-publish --prepare
      GEM_HOST_OTP_CODE=<otp> .ace-bin/ace-rubygems-publish
      GEM_HOST_OTP_CODE=<otp> .ace-bin/ace-rubygems-publish ace-support-core ace-support-cli
  USAGE
end

def abort!(message)
  warn "✗ #{message}"
  exit 1
end

# --- credentials -------------------------------------------------------------

def credentials_available?
  return true if ENV["GEM_HOST_API_KEY"]&.match?(/\S/)

  credentials = Pathname.new(Dir.home).join(".gem", "credentials")
  credentials.file? && !credentials.empty?
end

def validate_credentials!
  return if credentials_available?

  hints = []
  mise_toml = ROOT.join("mise.toml")
  if mise_toml.exist? && mise_toml.read.include?("GEM_HOST_API_KEY")
    hints << "mise.toml maps GEM_HOST_API_KEY from {{env.GEM_HOST_API_KEY}}, which resolves " \
             "empty unless the calling shell exports it (e.g. via your shell profile or `mise set`)."
  end
  hints << "Or create ~/.gem/credentials with a :rubygems_api_key entry."

  abort! <<~MSG.rstrip
    GEM_HOST_API_KEY is empty or unset and no ~/.gem/credentials found.

    Export a valid RubyGems API key before publishing:
      export GEM_HOST_API_KEY=<your-api-key>

    #{hints.join("\n")}
  MSG
end

def probe_credentials!
  _output, status = Open3.capture2e(NON_OTP_ENV, "gem", "owner", PROBE_GEM)
  return if status.success?

  abort!("RubyGems rejected the configured credentials during the ownership probe; nothing was pushed")
rescue SystemCallError
  abort!("Could not run RubyGems to verify configured credentials; nothing was pushed")
end

def validate_otp!
  otp = ENV["GEM_HOST_OTP_CODE"]
  return if otp&.match?(OTP_PATTERN)

  abort!("GEM_HOST_OTP_CODE is missing or invalid; expected 6-8 alphanumeric characters")
end

# --- discovery ---------------------------------------------------------------

def load_local_specs
  specs = {}
  Dir.glob(ROOT.join("ace-*/*.gemspec")).sort.each do |gemspec_path|
    spec = Gem::Specification.load(gemspec_path)
    abort!("Failed to load gemspec: #{gemspec_path}") unless spec
    abort!("Duplicate local gem name: #{spec.name}") if specs.key?(spec.name)

    specs[spec.name] = {spec: spec, dir: File.dirname(gemspec_path), gemspec: File.basename(gemspec_path)}
  end
  abort!("No ace-*/**.gemspec found under #{ROOT}") if specs.empty?
  specs
end

def internal_runtime_deps(specs)
  specs.transform_values do |entry|
    entry[:spec].dependencies
      .select do |dependency|
        dependency.type == :runtime &&
          dependency.name.start_with?("ace-") &&
          dependency.name != entry[:spec].name &&
          specs.key?(dependency.name)
      end
      .map(&:name)
      .sort
  end
end

# Kahn levels: every gem's dependencies live in strictly earlier levels, so any
# chunking of a level keeps the publish order dependency-safe.
def dependency_levels(graph)
  indegree = graph.transform_values(&:size)
  dependents = Hash.new { |hash, key| hash[key] = [] }
  graph.each { |name, deps| deps.each { |dep| dependents[dep] << name } }

  levels = []
  frontier = graph.keys.select { |name| indegree[name].zero? }.sort
  until frontier.empty?
    levels << frontier.sort
    next_frontier = []
    frontier.each do |name|
      dependents[name].each do |dependent|
        indegree[dependent] -= 1
        next_frontier << dependent if indegree[dependent].zero?
      end
    end
    frontier = next_frontier
  end

  unresolved = graph.keys - levels.flatten
  abort!("Circular dependency detected among: #{unresolved.sort.join(", ")}") unless unresolved.empty?
  levels
end

def fetch_remote_versions
  stdout, status = Open3.capture2(NON_SECRET_ENV, "gem", "search", "ace-", "--remote", "--versions")
  abort!("Failed to query RubyGems for published versions (gem search exited #{status.exitstatus})") unless status.success?

  versions = {}
  stdout.each_line do |line|
    next unless line =~ /^(ace-[^ ]+) \(([^)]+)\)$/

    name = Regexp.last_match(1)
    highest = Regexp.last_match(2)
      .split(/,\s*/)
      .reject(&:empty?)
      .max_by { |version| Gem::Version.new(version) }
    versions[name] = highest if highest
  end
  versions
end

# --- queue -------------------------------------------------------------------

def selected_gems(specs, graph, gems_filter, pending)
  return specs.keys if gems_filter.empty?

  unknown = gems_filter - specs.keys
  abort!("Unknown gem(s): #{unknown.join(", ")} — no gemspec found") unless unknown.empty?

  selected = gems_filter.dup
  visit = lambda do |name|
    return unless pending.key?(name)

    graph.fetch(name).each do |dependency|
      next unless pending.key?(dependency)

      unless selected.include?(dependency)
        selected << dependency
        puts "note: including pending dependency #{dependency} #{pending[dependency]} (required by #{name})"
      end
      visit.call(dependency)
    end
  end
  gems_filter.sort.each { |name| visit.call(name) }
  selected
end

def build_queue(specs, graph, levels, remote_versions, gems_filter)
  pending = {}

  levels.flatten.each do |name|
    entry = specs.fetch(name)
    local_version = entry[:spec].version.to_s
    remote_version = remote_versions[name]

    if remote_version && Gem::Version.new(local_version) <= Gem::Version.new(remote_version)
      next
    end
    pending[name] = local_version
  end

  selected = selected_gems(specs, graph, gems_filter, pending)
  skipped_published = selected.reject { |name| pending.key?(name) }.sort

  queue = []
  wave = 0
  levels.each do |level|
    level.select { |name| selected.include?(name) && pending.key?(name) }
      .sort
      .each_slice(MAX_CONCURRENCY) do |chunk|
      wave += 1
      chunk.each do |name|
        entry = specs.fetch(name)
        queue << {
          name: name,
          version: pending[name],
          wave: wave,
          artifact: File.join(entry[:dir], "#{name}-#{pending[name]}.gem")
        }
      end
    end
  end
  [queue, skipped_published]
end

def print_queue(queue, total_waves, mode)
  puts
  heading = case mode
  when :dry_run
    "[DRY RUN] Would publish #{queue.size} gem(s) in #{total_waves} wave(s):"
  when :prepare
    "[PREPARE] Building #{queue.size} gem(s) for #{total_waves} publish wave(s):"
  else
    "Publish queue: #{queue.size} gem(s), #{total_waves} wave(s) of ≤#{MAX_CONCURRENCY} concurrent pushes"
  end
  puts heading
  queue.each_with_index do |item, index|
    puts format(
      "  %2d. wave %-2d %-36s %-10s %s",
      index + 1, item[:wave], item[:name], item[:version],
      item[:artifact].sub("#{ROOT}/", "")
    )
  end
  puts
end

# --- build -------------------------------------------------------------------

def validate_artifact!(item)
  artifact_spec = Gem::Package.new(item[:artifact]).spec
  return if artifact_spec.name == item[:name] && artifact_spec.version.to_s == item[:version]

  abort!("Existing artifact does not match #{item[:name]} #{item[:version]}: #{item[:artifact]}")
rescue Gem::Exception
  abort!("Existing artifact is invalid for #{item[:name]} #{item[:version]}: #{item[:artifact]}")
end

def build_artifacts!(specs, queue)
  reused = 0
  queue.each do |item|
    entry = specs.fetch(item[:name])
    if File.exist?(item[:artifact])
      validate_artifact!(item)
      reused += 1
      next
    end
    _output, status = Open3.capture2e(NON_SECRET_ENV, "gem", "build", entry[:gemspec], chdir: entry[:dir])
    artifact_ok = File.exist?(item[:artifact])
    abort!("Build failed for #{item[:name]} #{item[:version]} — aborted before any push, OTP not consumed.") unless status.success? && artifact_ok

    validate_artifact!(item)
  end
  puts "✓ #{queue.size} artifact(s) ready: #{queue.size - reused} newly built, #{reused} reused from disk (no rebuild)"
end

# --- publish -----------------------------------------------------------------

def push_one(item)
  output, status = Open3.capture2e(
    "gem", "push", File.basename(item[:artifact]),
    chdir: File.dirname(item[:artifact])
  )
  if status.success? && output.include?("Successfully registered gem")
    :published
  elsif output.match?(/already been published|already exists/i)
    :already_published
  elsif output.match?(/otp/i) && output.match?(/invalid|expired|incorrect|missing/i)
    :otp_rejected
  else
    :failed
  end
end

def publish!(queue)
  started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  results = Hash.new { |hash, key| hash[key] = [] }

  queue.group_by { |item| item[:wave] }.sort.each do |_wave, items|
    items.each_slice(MAX_CONCURRENCY) do |chunk|
      outcomes = chunk.map { |item| Thread.new { [item, push_one(item)] } }.map(&:value)
      failed = false

      outcomes.each do |item, outcome|
        case outcome
        when :published
          File.delete(item[:artifact]) if File.exist?(item[:artifact])
          results[:published] << item
          puts "✓ Published #{item[:name]} #{item[:version]}"
        when :already_published
          File.delete(item[:artifact]) if File.exist?(item[:artifact])
          results[:already_published] << item
          puts "⊘ Skipped #{item[:name]} #{item[:version]} (already published on RubyGems)"
        when :otp_rejected
          results[:otp_rejected] << item
          puts "✗ #{item[:name]} #{item[:version]} — OTP rejected or expired"
          failed = true
        else
          results[:failed] << item
          puts "✗ Failed #{item[:name]} #{item[:version]} — RubyGems push failed"
          failed = true
        end
      end

      if failed
        remaining = queue.select { |item| File.exist?(item[:artifact]) }
        puts
        puts "Stopped after failure. Remaining unpublished artifacts kept on disk:"
        remaining.each { |item| puts "  #{item[:artifact].sub("#{ROOT}/", "")}" }
        if results[:otp_rejected].any?
          puts "Set a FRESH GEM_HOST_OTP_CODE and rerun to resume."
        end
        exit 1
      end
    end
  end

  elapsed = (Process.clock_gettime(Process::CLOCK_MONOTONIC) - started).round(1)
  puts
  puts "Done in #{elapsed}s"
  results
end

# --- main --------------------------------------------------------------------

if ARGV.include?("--help") || ARGV.include?("-h")
  puts usage
  exit 0
end

dry_run = ARGV.delete("--dry-run")
prepare = ARGV.delete("--prepare")
abort!("Choose either --dry-run or --prepare, not both") if dry_run && prepare
abort!("Unknown option: #{ARGV.grep(/\A--/).join(", ")}\n\n#{usage}") if ARGV.any?(/\A--/)
abort!("OTP values are forbidden in command arguments; use GEM_HOST_OTP_CODE") if ARGV.any? { |arg| arg.match?(OTP_PATTERN) }

gems_filter = ARGV

# Credentials first: fail fast before any slow work or OTP consumption.
unless dry_run
  validate_credentials!
  probe_credentials!
end

puts "Resolving publish queue..."
specs = load_local_specs
graph = internal_runtime_deps(specs)
levels = dependency_levels(graph)
remote_versions = fetch_remote_versions
queue, skipped_published = build_queue(specs, graph, levels, remote_versions, gems_filter)

skipped_published.each do |name|
  puts "⊘ #{name} #{specs.fetch(name)[:spec].version} already published on RubyGems"
end

if queue.empty?
  puts "Nothing to publish — all requested gems are up to date on RubyGems."
  exit 0
end

total_waves = queue.map { |item| item[:wave] }.max
mode = if dry_run
  :dry_run
elsif prepare
  :prepare
else
  :live
end
print_queue(queue, total_waves, mode)

exit 0 if dry_run

build_artifacts!(specs, queue)
if prepare
  puts "Prepared all artifacts. Set GEM_HOST_OTP_CODE through the approved secret environment and rerun without --prepare."
  exit 0
end

validate_otp!
publish!(queue)

puts
published = queue.size
puts "Published: #{published}  Waves: #{total_waves} × ≤#{MAX_CONCURRENCY} concurrent  Mode: live"
puts "Next step: run `ace-test-e2e ace-monorepo-e2e TS-MONO-001` to verify installation propagation."
