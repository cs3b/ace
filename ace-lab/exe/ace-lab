#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "ace/lab"

# No args -> show help
args = ARGV.empty? ? ["--help"] : ARGV

# Start CLI with exception-based exit code handling (per ADR-023)
begin
  exit_code = Ace::Lab::CLI.start(args)
  exit(exit_code) if exit_code.is_a?(Integer) && exit_code.nonzero?
rescue Ace::Support::Cli::Error => e
  # e.to_s carries the documented "Error: " prefix (Ace::Support::Cli::Error)
  warn e.to_s # standard:disable Lint/RedundantStringCoercion
  exit(e.exit_code)
end
