#!/usr/bin/env ruby
# frozen_string_literal: true

require "socket"
require "ace/lab/auth/issuer_server"

begin
  unless ENV["LISTEN_PID"] == Process.pid.to_s && ENV["LISTEN_FDS"] == "1"
    raise IOError, "socket activation is required"
  end
  socket = Socket.for_fd(3)
  unless socket.getsockopt(Socket::SOL_SOCKET, Socket::SO_TYPE).int == Socket::SOCK_STREAM &&
      socket.getsockopt(Socket::SOL_SOCKET, Socket::SO_ACCEPTCONN).int == 1 &&
      socket.local_address.afamily == Socket::AF_UNIX
    raise IOError, "Unix stream socket activation is required"
  end
  %w[LISTEN_PID LISTEN_FDS LISTEN_FDNAMES].each { |key| ENV.delete(key) }
  Ace::Lab::Auth::IssuerServer.new.run(socket, invocation: ENV["INVOCATION_ID"])
rescue SystemCallError, IOError, ArgumentError, Ace::Lab::Auth::Error
  warn "ace-lab auth issuer request requires an activated stream socket"
  exit 1
end
