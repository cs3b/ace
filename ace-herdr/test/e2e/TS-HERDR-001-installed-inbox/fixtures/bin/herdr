#!/bin/sh
if [ "$1" = pane ] && [ "$2" = get ] && [ "$3" = p1 ]; then
  if [ "${ACE_E2E_AGENT:-codex}" = pi ]; then
    printf '%s\n' '{"result":{"pane":{"pane_id":"p1","workspace_id":"ws1","terminal_id":"term-1","agent":"pi","agent_status":"idle","agent_session":{"agent":"pi","kind":"id","value":"0123abcd-0000-4000-8000-000000000001"}}}}'
    exit 0
  fi
  printf '%s\n' '{"result":{"pane":{"pane_id":"p1","workspace_id":"ws1","terminal_id":"term-1","agent":"codex","agent_status":"busy","agent_session":{"agent":"codex","kind":"id","value":"0123abcd-0000-4000-8000-000000000001"}}}}'
  exit 0
fi
if [ "$1" = agent ] && [ "$2" = prompt ] && [ "$3" = p1 ] && [ "$4" = 'Check your native queued messages.' ]; then
  printf '%s\n' "$4" >> "$ACE_E2E_WAKE_LOG"
  printf '%s\n' '{"ok":true}'
  exit 0
fi
printf '%s\n' 'unsupported herdr test command' >&2
exit 2
