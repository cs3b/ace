diff --git a/src/app/api/isolated_agents.rs b/src/app/api/isolated_agents.rs
new file mode 100644
index 0000000..6c74c8a
--- /dev/null
+++ b/src/app/api/isolated_agents.rs
@@ -0,0 +1,211 @@
+use super::responses::{encode_error, encode_success};
+use crate::api::schema::{AgentStartIsolatedParams, ResponseResult};
+use crate::app::App;
+use crate::events::{AppEvent, IsolatedLaunchResult};
+use std::sync::mpsc::Sender;
+
+impl App {
+    pub(super) fn defer_isolated_agent_launch(
+        &mut self,
+        id: String,
+        mut params: AgentStartIsolatedParams,
+        respond_to: Sender<String>,
+    ) {
+        let failure = if !crate::platform::supports_isolated_sessions() {
+            Some(("unsupported", "isolated sessions require Linux"))
+        } else if !crate::app::agents::valid_agent_name(&params.name) {
+            Some(("invalid_name", "invalid agent name"))
+        } else if self.isolated_launches.contains(&params.name)
+            || !self.agent_name_conflicts(&params.name, "").is_empty()
+        {
+            Some((
+                "duplicate_agent_name",
+                "agent name is already active or launching",
+            ))
+        } else if self.isolated_launches.len() >= 16 {
+            Some(("launch_capacity", "too many pending isolated launches"))
+        } else {
+            None
+        };
+        if let Some((code, message)) = failure {
+            let _ = respond_to.send(encode_error(id, code, message));
+            return;
+        }
+        let Some(workspace_id) = self
+            .parse_workspace_id(&params.workspace_id)
+            .and_then(|index| self.state.workspaces.get(index))
+            .map(|workspace| workspace.id.clone())
+        else {
+            let _ = respond_to.send(encode_error(
+                id,
+                "workspace_not_found",
+                "launch workspace is unavailable",
+            ));
+            return;
+        };
+        params.workspace_id = workspace_id;
+        self.isolated_launches.insert(params.name.clone());
+        let (rows, cols) = self.state.estimate_pane_size();
+        let events = self.event_tx.clone();
+        tokio::task::spawn_blocking(move || {
+            let result =
+                crate::platform::spawn_isolated_session(&params.project, &params.role, rows, cols);
+            let completion = IsolatedLaunchResult {
+                id,
+                params,
+                rows,
+                cols,
+                result,
+                respond_to,
+            };
+            // If the app has gone away, dropping this result closes the
+            // lifecycle channel and the root issuer contains the session.
+            let _ = events.blocking_send(AppEvent::IsolatedLaunchFinished(Box::new(completion)));
+        });
+    }
+
+    pub(super) fn finish_isolated_agent_launch(&mut self, result: IsolatedLaunchResult) {
+        let IsolatedLaunchResult {
+            id,
+            params,
+            rows,
+            cols,
+            result,
+            respond_to,
+        } = result;
+        self.isolated_launches.remove(&params.name);
+        let spawned = match result {
+            Ok(spawned) => spawned,
+            Err(error) => {
+                let _ = respond_to.send(encode_error(
+                    id,
+                    "isolated_launch_failed",
+                    error.to_string(),
+                ));
+                return;
+            }
+        };
+        let Some(ws_idx) = self
+            .state
+            .workspaces
+            .iter()
+            .position(|workspace| workspace.id == params.workspace_id)
+        else {
+            let _ = respond_to.send(encode_error(
+                id,
+                "workspace_not_found",
+                "launch workspace was removed",
+            ));
+            return;
+        };
+        if !self.agent_name_conflicts(&params.name, "").is_empty() {
+            let _ = respond_to.send(encode_error(
+                id,
+                "duplicate_agent_name",
+                "agent name became unavailable",
+            ));
+            return;
+        }
+        let created = self.state.workspaces[ws_idx].create_isolated_tab(
+            rows,
+            cols,
+            spawned,
+            self.state.pane_scrollback_limit_bytes,
+            self.state.host_terminal_theme,
+            self.state.host_terminal_appearance,
+        );
+        let (tab_idx, mut terminal, runtime) = match created {
+            Ok(created) => created,
+            Err(error) => {
+                let _ = respond_to.send(encode_error(
+                    id,
+                    "isolated_attach_failed",
+                    error.to_string(),
+                ));
+                return;
+            }
+        };
+        let pane_id = self.state.workspaces[ws_idx].tabs[tab_idx].root_pane;
+        let terminal_id = terminal.id.clone();
+        terminal.isolated_launch = Some(crate::terminal::state::IsolatedSessionConfig {
+            project: params.project,
+            role: params.role,
+        });
+        terminal.begin_managed_agent(
+            params.name,
+            crate::detect::Agent::Pi,
+            std::time::Instant::now(),
+            crate::app::agents::AGENT_START_SETTLE_DELAY,
+            std::time::Duration::from_secs(120),
+        );
+        self.terminal_runtimes.insert(terminal_id.clone(), runtime);
+        self.state.terminals.insert(terminal_id.clone(), terminal);
+        self.state.remove_alias_shadowed_by_new_pane(pane_id);
+        let agent = self
+            .agent_info(ws_idx, pane_id)
+            .expect("new isolated terminal must have agent information");
+        let response = encode_success(id, ResponseResult::AgentIsolatedStarted { agent });
+        // Starts are server-owned, like ordinary native agent.start. Losing
+        // the API response does not cancel an accepted session: callers can
+        // rediscover it by its reserved name, never launch a duplicate.
+        self.emit_tab_created_events(ws_idx, tab_idx);
+        let _ = respond_to.send(response);
+        self.state.mark_session_dirty();
+        self.schedule_session_save();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn app() -> App {
+        let (_tx, rx) = tokio::sync::mpsc::unbounded_channel();
+        App::new(
+            &crate::config::Config::default(),
+            crate::app::AppPolicy::TEST,
+            None,
+            rx,
+            crate::api::EventHub::default(),
+        )
+    }
+    fn params() -> AgentStartIsolatedParams {
+        AgentStartIsolatedParams {
+            name: "worker".into(),
+            workspace_id: "missing".into(),
+            project: "ace".into(),
+            role: "worker".into(),
+        }
+    }
+    #[tokio::test]
+    async fn isolated_missing_workspace_never_reserves_or_creates_a_terminal() {
+        let mut app = app();
+        let (tx, rx) = std::sync::mpsc::channel();
+        let before = app.state.terminals.len();
+        let mut request = params();
+        request.workspace_id = "999999".into();
+        app.defer_isolated_agent_launch("test".into(), request, tx);
+        let reply: serde_json::Value = serde_json::from_str(&rx.recv().unwrap()).unwrap();
+        assert!(reply.get("error").is_some());
+        assert!(app.isolated_launches.is_empty());
+        assert_eq!(app.state.terminals.len(), before);
+    }
+    #[tokio::test]
+    async fn isolated_failed_launch_releases_name_without_creating_topology() {
+        let mut app = app();
+        app.isolated_launches.insert("worker".into());
+        let (tx, rx) = std::sync::mpsc::channel();
+        let before = app.state.terminals.len();
+        app.finish_isolated_agent_launch(IsolatedLaunchResult {
+            id: "test".into(),
+            params: params(),
+            rows: 24,
+            cols: 80,
+            result: Err(std::io::Error::other("controlled launch refusal")),
+            respond_to: tx,
+        });
+        let reply: serde_json::Value = serde_json::from_str(&rx.recv().unwrap()).unwrap();
+        assert_eq!(reply["error"]["code"], "isolated_launch_failed");
+        assert!(app.isolated_launches.is_empty());
+        assert_eq!(app.state.terminals.len(), before);
+    }
+}
