+fn input_drain_pure_tests_closed_wire_and_exact_origin() {
+    let origin = serde_json::json!({
+        "terminal_id": "term_ab", "runtime_incarnation": "12345678-1234-1234-1234-123456789abc",
+        "child": {"pid": 12, "uid": 42, "gid": 42, "groups": [42], "parent_pid": 11,
+                  "started_at": "linux:12345678-1234-1234-1234-123456789abc:123", "host": "fixture"}
+    });
+    let request = serde_json::json!({"target": "term_ab", "expected_origin": origin});
+    let params: TerminalInhibitInputParams =
+        serde_json::from_value(request.clone()).expect("closed request");
+    assert!(params.valid());
+    let mut changed = request.clone();
+    changed["target"] = serde_json::json!("pane_ab");
+    assert!(
+        !serde_json::from_value::<TerminalInhibitInputParams>(changed)
+            .expect("typed alias")
