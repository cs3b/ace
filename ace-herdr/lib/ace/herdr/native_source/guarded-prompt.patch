+    server.handle_api_request_with_shutdown_check(api::ApiRequestMessage {
+        request: api::schema::Request {
+            id: "isolated-dispatch".into(),
+            method: api::schema::Method::AgentStartIsolated(
+                api::schema::AgentStartIsolatedParams {
+                    name: "worker".into(),
+                    workspace_id: "999999".into(),
+                    project: "ace".into(),
+                    role: "worker".into(),
+                },
+            ),
+        },
+        respond_to,
+        response_write_complete: None,
+    });
+    let reply: serde_json::Value =
+        serde_json::from_str(&response_rx.recv_timeout(Duration::from_secs(1)).unwrap()).unwrap();
+    let expected = if crate::platform::supports_isolated_sessions() {
+        "workspace_not_found"
+    } else {
+        "unsupported"
+    };
+    assert_eq!(reply["error"]["code"], expected);
+    assert!(server.app.isolated_launches.is_empty());
+    shutdown_test_runtimes(&mut server);
+}
