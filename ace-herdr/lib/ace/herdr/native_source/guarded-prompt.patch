+    fn queue_guarded_agent_prompt(
+        &mut self,
+        id: String,
+        params: AgentPromptParams,
+    ) -> Result<
+        (
+            String,
+            crate::api::schema::AgentInfo,
+            GuardedPromptOrigin,
+            std::sync::mpsc::Receiver<Result<(), GuardedPromptError>>,
+        ),
+        String,
+    > {
+        let expected = params
+            .validate_guarded()
+            .map_err(|error| guarded_error(id.clone(), error))?;
+        // The guarded branch never uses public pane/name or generic resolver fallback.
+        let resolved = self
+            .resolve_guarded_agent_target(&params.target)
+            .map_err(|_| guarded_error(id.clone(), GuardedPromptError::TargetMissing))?;
+        let terminal = self
+            .state
+            .terminals
+            .get(params.target.as_str())
+            .ok_or_else(|| guarded_error(id.clone(), GuardedPromptError::TargetMissing))?;
+        if terminal.state == crate::detect::AgentState::Blocked {
+            return Err(guarded_error(id, GuardedPromptError::AgentBlocked));
+        }
+        let expected_agent = terminal
+            .effective_known_agent()
+            .ok_or_else(|| guarded_error(id.clone(), GuardedPromptError::AgentNotReady))?;
+        if terminal.managed_agent_launch_pending() {
+            return Err(guarded_error(id, GuardedPromptError::AgentNotReady));
+        }
+        let runtime = self
+            .lookup_runtime_sender(resolved.ws_idx, resolved.pane_id)
+            .ok_or_else(|| guarded_error(id.clone(), GuardedPromptError::OriginUnavailable))?;
+        let actual = runtime
+            .guarded_prompt_origin(&params.target)
+            .ok_or_else(|| guarded_error(id.clone(), GuardedPromptError::OriginUnavailable))?;
+        if actual != *expected {
+            return Err(guarded_error(id, GuardedPromptError::GuardMismatch));
+        }
+        if !super::super::agents::runtime_hosts_agent(runtime, expected_agent) {
+            return Err(guarded_error(id, GuardedPromptError::AgentNotReady));
+        }
+        let (mut text, enter) =
+            crate::app::api_helpers::encode_api_submission_parts(runtime, &params.text);
+        if enter.is_empty() || text.is_empty() {
+            return Err(guarded_error(id, GuardedPromptError::OriginUnavailable));
+        }
+        if expected_agent == crate::detect::Agent::GithubCopilot {
+            let mut focus = crate::ghostty::encode_focus(crate::ghostty::FocusEvent::Gained)
+                .map_err(|_| guarded_error(id.clone(), GuardedPromptError::OriginUnavailable))?;
+            focus.append(&mut text);
+            text = focus;
+        }
+        let agent = self
+            .agent_info(resolved.ws_idx, resolved.pane_id)
+            .ok_or_else(|| guarded_error(id.clone(), GuardedPromptError::AgentNotReady))?;
+        let completion = runtime
+            .queue_guarded_submission(
+                Bytes::from(text),
+                Bytes::from(enter),
+                AGENT_PROMPT_SUBMIT_DELAY,
+                expected.clone(),
+            )
+            .map_err(|error| guarded_error(id.clone(), error))?;
+        Ok((id, agent, expected.clone(), completion))
+    }
