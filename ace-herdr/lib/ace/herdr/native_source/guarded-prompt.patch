new file mode 100644
index 0000000..3c6a93d
--- /dev/null
+++ b/src/platform/linux/session_launch.rs
@@ -0,0 +1,93 @@
+//! Configured launch client for the existing root-owned ACE issuer.
+use super::session_handoff;
+use crate::pty::backend::SpawnedPty;
+use std::io::{self, Write};
+use std::os::unix::{
+    fs::{FileTypeExt, MetadataExt},
+    net::UnixStream,
+};
+use std::time::Duration;
+
+const ENDPOINT: &str = "/run/lab/ace-lab-auth.sock";
+
+fn request(project: &str, role: &str, rows: u16, cols: u16) -> io::Result<Vec<u8>> {
+    if project.is_empty()
+        || project.len() > 512
+        || project.chars().any(char::is_control)
+        || !matches!(
+            role,
+            "lab-overseer" | "project-overseer" | "worker" | "verifier" | "integrator"
+        )
+        || rows == 0
+        || cols == 0
+    {
+        return Err(io::Error::other("invalid configured session launch"));
+    }
+    let mut bytes = serde_json::to_vec(&serde_json::json!({
+        "action": "launch", "project": project, "role": role, "rows": rows, "cols": cols
+    }))?;
+    bytes.push(b'\n');
+    Ok(bytes)
+}
+
+pub(crate) fn spawn_isolated_session(
+    project: &str,
+    role: &str,
+    rows: u16,
+    cols: u16,
+) -> io::Result<SpawnedPty> {
+    let request = request(project, role, rows, cols)?;
+    for path in ["/", "/run", "/run/lab"] {
+        let metadata = std::fs::symlink_metadata(path)?;
+        if !metadata.is_dir() || metadata.uid() != 0 || metadata.mode() & 0o022 != 0 {
+            return Err(io::Error::other("session launcher path is not protected"));
+        }
+    }
+    let metadata = std::fs::symlink_metadata(ENDPOINT)?;
+    if !metadata.file_type().is_socket() || metadata.uid() != 0 {
+        return Err(io::Error::other(
+            "session launcher endpoint is not protected",
+        ));
+    }
+    let mut stream = UnixStream::connect(ENDPOINT)?;
+    stream.set_write_timeout(Some(Duration::from_secs(5)))?;
+    stream.write_all(&request)?;
+    let handoff = session_handoff::receive(stream)?;
+    if handoff.rows != rows || handoff.cols != cols {
+        return Err(io::Error::other("session terminal geometry differs"));
+    }
+    Ok(SpawnedPty {
+        master_fd: handoff.master,
+        origin: Some(handoff.origin),
+        child: Box::new(handoff.child),
+        isolated: true,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn configured_request_contains_no_command_or_identity_override() {
+        let bytes = request("ace", "worker", 24, 80).unwrap();
+        assert_eq!(bytes.last(), Some(&b'\n'));
+        let value: serde_json::Value = serde_json::from_slice(&bytes).unwrap();
+        assert_eq!(
+            value,
+            serde_json::json!({"action":"launch", "project":"ace", "role":"worker", "rows":24, "cols":80})
+        );
+    }
+    #[test]
+    fn invalid_request_is_rejected_before_connecting() {
+        for (project, role, rows, cols) in [
+            ("", "worker", 24, 80),
+            ("ace\n", "worker", 24, 80),
+            ("ace", "root", 24, 80),
+            ("ace", "worker", 0, 80),
+            ("ace", "worker", 24, 0),
+        ] {
+            assert!(request(project, role, rows, cols).is_err());
+        }
+        assert!(request(&"a".repeat(513), "worker", 24, 80).is_err());
+    }
+}
