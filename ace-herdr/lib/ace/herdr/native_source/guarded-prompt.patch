+        serde_json::to_value(response).expect("reply"),
+        serde_json::json!({
+            "type": "terminal_input_drained", "origin": origin, "input_state": "inhibited", "pending_input": 0
+        })
+    );
+    for code in [
+        InputDrainCode::InvalidParams,
+        InputDrainCode::GuardMismatch,
+        InputDrainCode::OriginUnavailable,
+        InputDrainCode::Unavailable,
