+            Err(GuardedPromptError::SubmissionUncertain)
+        );
+        runner.file.stop_after = None;
+        runner.schedule_submission_enter();
+        runner.flush_pending_writes_once().expect("inhibited");
+        assert_eq!(runner.file.bytes, b"fo");
+    }
+    #[test]
+    fn input_drain_pure_tests_lost_ack_repeat_and_exited_same_actor_are_positive() {
+        let (mut runner, _, live, expected) = controlled_runner();
+        live.0.store(false, Ordering::Release);
+        runner.origin.as_ref().expect("origin").mark_exited();
+        let (control, received) = std_mpsc::channel();
+        let lost = queue_input_inhibit(
+            runner.origin.as_deref(),
+            &expected,
+            &runner.user_writes,
+            &control,
+        )
+        .expect("first");
+        drop(lost);
+        runner.handle_control_command(received.recv().expect("barrier"));
+        assert_eq!(inhibit(&mut runner, &expected), Ok(()));
+        assert!(!runner.user_writes.lock().expect("gate").reopen());
+    }
+    #[test]
+    fn input_drain_pure_tests_wrong_imported_replaced_or_released_actor_never_grants() {
+        let (mut runner, _, _, expected) = controlled_runner();
+        let mut other = expected.clone();
+        other.runtime_incarnation = "00000000-0000-4000-8000-000000000009".into();
+        assert_eq!(
+            inhibit(&mut runner, &other),
+            Err(InputDrainError::GuardMismatch)
+        );
+        assert!(runner.user_writes.lock().expect("gate").accepting);
+        runner.origin = None;
+        assert_eq!(
+            inhibit(&mut runner, &expected),
+            Err(InputDrainError::OriginUnavailable)
+        );
+        let (mut runner, _, _, expected) = controlled_runner();
+        runner.state = ActorState::Released;
+        assert_eq!(
+            inhibit(&mut runner, &expected),
+            Err(InputDrainError::Unavailable)
+        );
+    }
+    #[test]
+    fn input_drain_pure_tests_control_loss_is_inhibited_unconfirmed() {
+        let (runner, _, _, expected) = controlled_runner();
+        let (control, received) = std_mpsc::channel();
+        drop(received);
+        assert!(matches!(
+            queue_input_inhibit(
+                runner.origin.as_deref(),
+                &expected,
+                &runner.user_writes,
+                &control
+            ),
+            Err(InputDrainError::Unavailable)
+        ));
+        let mut gate = runner.user_writes.lock().expect("gate");
+        assert!(gate.scope_inhibited);
+        assert!(!gate.accepting);
+        assert!(!gate.reopen());
+    }
+    #[test]
+    fn input_drain_pure_tests_prequeued_handoff_rollback_cannot_reopen_or_transfer() {
+        let (mut runner, _, _, expected) = controlled_runner();
+        let (control, received) = std_mpsc::channel();
+        runner.control_rx = received;
+        let (rollback, rollback_result) = std_mpsc::channel();
+        let (handoff, handoff_result) = std_mpsc::channel();
+        let (duplicate, duplicate_result) = std_mpsc::channel();
+        control
+            .send(PtyIoControlCommand::RollbackHandoff(rollback))
+            .expect("queued rollback");
+        control
+            .send(PtyIoControlCommand::BeginHandoff(handoff))
+            .expect("queued handoff");
+        control
+            .send(PtyIoControlCommand::DuplicateForHandoff(duplicate))
+            .expect("queued duplicate");
+        let drained = queue_input_inhibit(
+            runner.origin.as_deref(),
+            &expected,
+            &runner.user_writes,
+            &control,
+        )
+        .expect("inhibit admission");
+        runner.state = ActorState::Quiesced;
+        assert!(!runner.drain_control_commands());
+        assert!(rollback_result.recv().expect("rollback refusal").is_err());
+        assert!(handoff_result.recv().expect("handoff refusal").is_err());
+        assert!(duplicate_result.recv().expect("dup refusal").is_err()); // descriptor sentinel would panic on a syscall
+        assert_eq!(drained.recv().expect("drain completion"), Ok(()));
+        assert!(!runner.user_writes.lock().expect("gate").accepting);
+        assert_eq!(inhibit(&mut runner, &expected), Ok(()));
+    }
+    #[test]
+    fn input_drain_pure_tests_paused_enqueue_cannot_append_after_drain_ack() {
+        let (mut runner, tx, _, expected) = controlled_runner();
+        let gate = Arc::clone(&runner.user_writes);
+        let (ready, start) = std_mpsc::channel();
+        let sender = std::thread::spawn(move || {
+            start
+                .recv_timeout(Duration::from_secs(2))
+                .expect("resume enqueue");
+            queue_plain_input(&tx, &gate, Bytes::from_static(b"delayed"))
+        });
+        assert_eq!(inhibit(&mut runner, &expected), Ok(()));
+        ready.send(()).expect("resume sender");
+        assert!(matches!(
+            sender.join().expect("sender"),
+            Err(mpsc::error::TrySendError::Closed(_))
+        ));
+        assert!(runner.data_rx.try_recv().is_err());
+        assert!(runner.file.bytes.is_empty());
+    }
+    #[test]
+    fn input_drain_pure_tests_paused_inflight_write_finishes_before_inhibit_and_no_later_write() {
+        let (mut runner, _, _, expected) = controlled_runner();
+        runner.enqueue_write(Bytes::from_static(b"first"));
+        let (started, observed) = std_mpsc::channel();
+        let (resume, proceed) = std_mpsc::channel();
+        runner.file.pause = Some((started, proceed));
+        let gate = Arc::clone(&runner.user_writes);
+        let origin = Arc::clone(runner.origin.as_ref().expect("origin"));
+        let (control, received) = std_mpsc::channel();
+        let worker = std::thread::spawn(move || {
+            runner.flush_pending_writes_once().expect("inflight write");
+            runner.handle_control_command(
+                received
+                    .recv_timeout(Duration::from_secs(2))
+                    .expect("barrier"),
+            );
+            runner.enqueue_write(Bytes::from_static(b"late"));
+            runner.flush_pending_writes_once().expect("late suppressed");
+            runner
+        });
+        observed
+            .recv_timeout(Duration::from_secs(2))
+            .expect("write paused");
+        let (attempted, attempting) = std_mpsc::channel();
+        let inhibitor = std::thread::spawn(move || {
+            attempted.send(()).expect("attempt inhibit");
+            queue_input_inhibit(Some(&origin), &expected, &gate, &control)
+                .expect("inhibit")
+                .recv_timeout(Duration::from_secs(2))
+                .expect("ack")
+        });
+        attempting
+            .recv_timeout(Duration::from_secs(2))
+            .expect("inhibit pending");
+        resume.send(()).expect("finish prior write");
+        assert_eq!(inhibitor.join().expect("inhibitor"), Ok(()));
+        let runner = worker.join().expect("worker");
+        assert_eq!(runner.file.bytes, b"first");
+        assert!(runner.pending_writes.is_empty());
+    }
+}
