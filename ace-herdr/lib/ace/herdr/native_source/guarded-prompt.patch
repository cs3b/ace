new file mode 100644
index 0000000000000000000000000000000000000000..7e6d3e94d05c5629abb1a9914c182072e5cae08a
--- /dev/null
+++ b/src/platform/guarded_prompt.rs
@@ -0,0 +1,519 @@
+//! Shared guarded-submission values and pure write-admission state.
+//! Kernel origin capture stays in the Linux platform owner.
+
+use serde::{Deserialize, Serialize};
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Arc,
+};
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, schemars::JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct GuardedChildIdentity {
+    pub pid: u32,
+    pub uid: u32,
+    pub gid: u32,
+    pub groups: Vec<u32>,
+    pub parent_pid: u32,
+    pub started_at: String,
+    pub host: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, schemars::JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct GuardedPromptOrigin {
+    pub terminal_id: String,
+    pub runtime_incarnation: String,
+    pub child: GuardedChildIdentity,
+}
+
+pub(crate) fn canonical_uuid(value: &str) -> bool {
+    value.len() == 36
+        && value.bytes().enumerate().all(|(i, b)| {
+            if [8, 13, 18, 23].contains(&i) {
+                b == b'-'
+            } else {
+                b.is_ascii_digit() || (b'a'..=b'f').contains(&b)
+            }
+        })
+}
+
+impl GuardedPromptOrigin {
+    pub(crate) fn valid(&self) -> bool {
+        let child = &self.child;
+        let mut birth = child.started_at.split(':');
+        let valid_birth = birth.next() == Some("linux")
+            && birth.next().is_some_and(canonical_uuid)
+            && birth.next().is_some_and(|ticks| {
+                !ticks.is_empty()
+                    && ticks.bytes().all(|b| b.is_ascii_digit())
+                    && ticks.parse::<u64>().is_ok_and(|n| n > 0)
+            })
+            && birth.next().is_none();
+        self.terminal_id.strip_prefix("term_").is_some_and(|id| {
+            (2..=48).contains(&id.len())
+                && id
+                    .bytes()
+                    .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        }) && canonical_uuid(&self.runtime_incarnation)
+            && child.pid > 0
+            && child.parent_pid > 0
+            && child.groups.len() <= 256
+            && child.groups.windows(2).all(|pair| pair[0] < pair[1])
+            && valid_birth
+            && !child.host.is_empty()
+            && child.host.len() <= 255
+            && !child.host.chars().any(char::is_control)
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum GuardedPromptError {
+    GuardMismatch,
+    OriginUnavailable,
+    OriginExited,
+    AgentBlocked,
+    AgentNotReady,
+    TargetMissing,
+    SubmissionBusy,
+    SubmissionUncertain,
+}
+
+impl GuardedPromptError {
+    pub(crate) fn code(self) -> &'static str {
+        match self {
+            Self::GuardMismatch => "guard_mismatch",
+            Self::OriginUnavailable => "origin_unavailable",
+            Self::OriginExited => "origin_exited",
+            Self::AgentBlocked => "agent_blocked",
+            Self::AgentNotReady => "agent_not_ready",
+            Self::TargetMissing => "target_missing",
+            Self::SubmissionBusy => "submission_busy",
+            Self::SubmissionUncertain => "submission_uncertain",
+        }
+    }
+    pub(crate) fn phase(self) -> &'static str {
+        if self == Self::SubmissionUncertain {
+            "issued_or_unknown"
+        } else {
+            "not_issued"
+        }
+    }
+}
+
+pub(crate) trait OriginLiveness: Send + Sync {
+    fn is_live(&self) -> std::io::Result<bool>;
+}
+
+pub(crate) struct GuardedChildOrigin {
+    pub(crate) runtime_incarnation: String,
+    pub(crate) child: GuardedChildIdentity,
+    pub(crate) exited: AtomicBool,
+    pub(crate) handle: Arc<dyn OriginLiveness>,
+}
+
+impl GuardedChildOrigin {
+    pub(crate) fn projection(&self, terminal_id: &str) -> GuardedPromptOrigin {
+        GuardedPromptOrigin {
+            terminal_id: terminal_id.to_owned(),
+            runtime_incarnation: self.runtime_incarnation.clone(),
+            child: self.child.clone(),
+        }
+    }
+    pub(crate) fn check(&self, expected: &GuardedPromptOrigin) -> Result<(), GuardedPromptError> {
+        if !expected.valid()
+            || expected.runtime_incarnation != self.runtime_incarnation
+            || expected.child != self.child
+        {
+            return Err(GuardedPromptError::GuardMismatch);
+        }
+        if self.exited.load(Ordering::Acquire) {
+            return Err(GuardedPromptError::OriginExited);
+        }
+        match self.handle.is_live() {
+            Ok(true) => Ok(()),
+            Ok(false) => Err(GuardedPromptError::OriginExited),
+            Err(_) => Err(GuardedPromptError::OriginUnavailable),
+        }
+    }
+    pub(crate) fn mark_exited(&self) {
+        self.exited.store(true, Ordering::Release);
+    }
+}
+
+/// Once a guarded write has been attempted, every failure is indeterminate.
+/// This does not claim atomicity between kernel exit and the subsequent write.
+#[derive(Default)]
+pub(crate) struct GuardedWriteState {
+    attempted: bool,
+    written: bool,
+}
+impl GuardedWriteState {
+    pub(crate) fn before_write(
+        &mut self,
+        admission: Result<(), GuardedPromptError>,
+    ) -> Result<(), GuardedPromptError> {
+        admission.map_err(|error| self.failure(error))?;
+        self.attempted = true;
+        Ok(())
+    }
+    pub(crate) fn write(
+        &mut self,
+        admission: Result<(), GuardedPromptError>,
+        write: impl FnOnce() -> std::io::Result<usize>,
+    ) -> Result<Option<usize>, GuardedPromptError> {
+        self.before_write(admission)?;
+        match write() {
+            Ok(0) => Err(GuardedPromptError::SubmissionUncertain),
+            Ok(bytes) => {
+                self.written(bytes);
+                Ok(Some(bytes))
+            }
+            Err(error)
+                if matches!(
+                    error.kind(),
+                    std::io::ErrorKind::WouldBlock | std::io::ErrorKind::Interrupted
+                ) =>
+            {
+                self.deferred();
+                Ok(None)
+            }
+            Err(_) => Err(GuardedPromptError::SubmissionUncertain),
+        }
+    }
+    pub(crate) fn written(&mut self, bytes: usize) {
+        self.written |= bytes > 0;
+    }
+    pub(crate) fn deferred(&mut self) {
+        self.attempted = self.written;
+    }
+    pub(crate) fn failure(&self, error: GuardedPromptError) -> GuardedPromptError {
+        if self.attempted {
+            GuardedPromptError::SubmissionUncertain
+        } else {
+            error
+        }
+    }
+}
+
+pub(crate) fn parse_linux_child_identity(
+    pid: u32,
+    status: &str,
+    stat: &str,
+    boot: &str,
+    host: &str,
+) -> std::io::Result<GuardedChildIdentity> {
+    let invalid = || std::io::Error::other("invalid child origin");
+    if !canonical_uuid(boot) || host.is_empty() || host.len() > 255 {
+        return Err(invalid());
+    }
+    let (prefix, fields) = stat.rsplit_once(") ").ok_or_else(invalid)?;
+    if prefix
+        .split_once(" (")
+        .and_then(|(n, _)| n.parse::<u32>().ok())
+        != Some(pid)
+    {
+        return Err(invalid());
+    }
+    let stat_fields: Vec<_> = fields.split_whitespace().collect();
+    if stat_fields.len() < 20 || matches!(stat_fields[0], "Z" | "X" | "x") {
+        return Err(invalid());
+    }
+    let ticks = stat_fields[19].parse::<u64>().map_err(|_| invalid())?;
+    let parent_pid = stat_fields[1].parse::<u32>().map_err(|_| invalid())?;
+    let mut uid = None;
+    let mut gid = None;
+    let mut groups = None;
+    let mut ppid = None;
+    for line in status.lines() {
+        let Some((key, raw)) = line.split_once(':') else {
+            continue;
+        };
+        if matches!(key, "Uid" | "Gid" | "Groups" | "PPid") {
+            let values: Vec<u32> = raw
+                .split_whitespace()
+                .map(str::parse)
+                .collect::<Result<_, _>>()
+                .map_err(|_| invalid())?;
+            match key {
+                "Uid" | "Gid" => {
+                    if values.len() != 4 || values.iter().any(|v| *v != values[0]) {
+                        return Err(invalid());
+                    }
+                    let cell = if key == "Uid" { &mut uid } else { &mut gid };
+                    if cell.replace(values[0]).is_some() {
+                        return Err(invalid());
+                    }
+                }
+                "Groups" => {
+                    if groups.is_some() || values.len() > 256 {
+                        return Err(invalid());
+                    }
+                    let mut values = values;
+                    values.sort_unstable();
+                    values.dedup();
+                    groups = Some(values);
+                }
+                "PPid" => {
+                    if values.len() != 1 || ppid.replace(values[0]).is_some() {
+                        return Err(invalid());
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
+    if pid == 0 || parent_pid == 0 || ppid != Some(parent_pid) || ticks == 0 {
+        return Err(invalid());
+    }
+    Ok(GuardedChildIdentity {
+        pid,
+        uid: uid.ok_or_else(invalid)?,
+        gid: gid.ok_or_else(invalid)?,
+        groups: groups.ok_or_else(invalid)?,
+        parent_pid,
+        started_at: format!("linux:{boot}:{ticks}"),
+        host: host.to_owned(),
+    })
+}
