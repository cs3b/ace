+// Admission starts a protected session; it does not claim first-turn/eyes readiness.
+fn agent_start_isolated(args: &[String]) -> std::io::Result<i32> {
+    let usage = "usage: herdr agent start-isolated <name> --workspace ID --project ID --role ROLE";
+    let Some(name) = args
+        .first()
+        .filter(|name| !name.starts_with('-') && !name.is_empty())
+    else {
+        eprintln!("{usage}");
+        return Ok(2);
+    };
+    let mut workspace = None;
+    let mut project = None;
+    let mut role = None;
+    let mut index = 1;
+    while index < args.len() {
+        let target = match args[index].as_str() {
+            "--workspace" => &mut workspace,
+            "--project" => &mut project,
+            "--role" => &mut role,
+            _ => {
+                eprintln!("{usage}");
+                return Ok(2);
+            }
+        };
+        let Some(value) = args
+            .get(index + 1)
+            .filter(|value| !value.starts_with('-') && !value.is_empty())
+        else {
+            eprintln!("{usage}");
+            return Ok(2);
+        };
+        if target.replace(value.clone()).is_some() {
+            eprintln!("{usage}");
+            return Ok(2);
+        }
+        index += 2;
+    }
+    let (Some(workspace_id), Some(project), Some(role)) = (workspace, project, role) else {
+        eprintln!("{usage}");
+        return Ok(2);
+    };
+    super::print_response(&super::send_request(&Request {
+        id: "cli:agent:start-isolated".into(),
+        method: Method::AgentStartIsolated(AgentStartIsolatedParams {
+            name: name.clone(),
+            workspace_id,
+            project,
+            role,
+        }),
+    })?)
+}
