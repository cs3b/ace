+    changed["expected_origin"]["child"]["pid"] = serde_json::json!(12.0);
+    assert!(serde_json::from_value::<TerminalInhibitInputParams>(changed).is_err());
+    let response = ResponseResult::TerminalInputDrained {
+        origin: params.expected_origin,
+        input_state: InputState::Inhibited,
+        pending_input: 0,
+    };
