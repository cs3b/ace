+    // Root-bound isolated sessions report the immutable terminal identity.
+    // Keep this exact: a missing terminal must never resolve as an agent name
+    // or a recycled pane alias. Ordinary pane reports retain their API.
+    fn resolve_report_pane(&self, target: &str) -> Option<(usize, PaneId)> {
+        if target.starts_with("term_") {
+            self.state.terminals.get(target)?;
+            let resolved = self.resolve_guarded_agent_target(target).ok()?;
+            return Some((resolved.ws_idx, resolved.pane_id));
+        }
+        self.parse_pane_id(target)
+    }
