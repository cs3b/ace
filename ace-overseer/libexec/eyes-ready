#!/usr/bin/env ruby
# frozen_string_literal: true
require "json"
require "ace/overseer/molecules/eyes_descriptor_evaluator"

begin
  raise ArgumentError unless ENV["ACE_TOOLCHAIN"] == "installed" && ARGV.empty?
  bytes = STDIN.read(16_385)
  raise ArgumentError if bytes.bytesize > 16_384
  input = JSON.parse(bytes, create_additions: false, allow_duplicate_key: false, max_nesting: 5)
  file = File.for_fd(3)
  ready = Ace::Overseer::Molecules::EyesDescriptorEvaluator.new.call(input, file: file)
  puts JSON.generate("ready" => ready)
rescue StandardError
  # Never render a parser exception or session content into the response.
  puts JSON.generate("ready" => false)
  exit 1
ensure
  file&.close
end
